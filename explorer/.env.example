# Copy this file to explorer/.env and fill in the key for the provider you use.
# explorer/.env is gitignored — it never gets committed.
# The easy runner (python explorer/run.py) can also create/update this for you.

# OpenAI / ChatGPT (the API needs its own credit — a ChatGPT subscription does NOT include it):
OPENAI_API_KEY=sk-...

# Anthropic / Claude:
ANTHROPIC_API_KEY=sk-ant-...
